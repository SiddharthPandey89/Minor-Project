# Earth GeoIntelligence ML service configuration
# Copy to .env and replace placeholder values before local development.

APP_ENV=development
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000
LOG_LEVEL=info

# Backend configuration
PORT=5000
NODE_ENV=development
DATABASE_URL=
CORS_ORIGIN=http://localhost:5173

# Optional Google Earth Engine configuration for satellite access.
