# Earth GeoIntelligence / TERRAX configuration template
# Copy to .env and replace placeholder values for local development.
# Never commit real credentials, service-account files, or API tokens.

# Runtime
APP_ENV=development
NODE_ENV=development
PORT=5000

# Backend (Render/local)
DATABASE_URL=
CORS_ORIGIN=http://localhost:5173
# Optional alias supported by backend CORS config:
# FRONTEND_URL=http://localhost:5173

# ML service (Render/local)
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000
LOG_LEVEL=info
# ML CORS: comma-separated origins (Netlify URL, custom domain, etc.). In development localhost origins are included automatically.
CORS_ORIGINS=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000

# Frontend (Netlify/local) - set in frontend build environment, not in backend .env
VITE_API_BASE_URL=http://localhost:5000
VITE_ML_SERVICE_URL=http://localhost:8000

# Optional: Google Earth Engine / satellite providers
GOOGLE_CLOUD_PROJECT_ID=
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PRIVATE_KEY_PATH=
GEE_USE_SERVICE_ACCOUNT=false
EARTHENGINE_AUTH_MODE=local
EARTHENGINE_API_BASE_URL=https://earthengine.googleapis.com

# Optional: external data providers (leave empty unless configured)
OPENTOPOGRAPHY_API_KEY=
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
COPERNICUS_API_BASE_URL=https://finder.creodias.eu
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1/search
COPERNICUS_ACCESS_TOKEN=
